{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/spell/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/page/[slug]/index.js": {
      "maxDuration": 10
    },
    "api/page/[slug]/stats.js": {
      "maxDuration": 10
    },
    "api/gallery.js": {
      "maxDuration": 10
    },
    "api/vote.js": {
      "maxDuration": 10
    },
    "api/cron/site-of-the-week.js": {
      "maxDuration": 60
    },
    "api/site-stats/homepage.js": {
      "maxDuration": 10
    },
    "api/contact-form.js": {
      "maxDuration": 10
    },
    "api/page/[slug]/set-contact-email.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/p/:slug", "destination": "/api/page/:slug" },
    { "source": "/gallery", "destination": "/api/gallery" }
  ],
  "crons": [
    { "path": "/api/cron/site-of-the-week", "schedule": "0 0 * * 1" }
  ]
}
