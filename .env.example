# AI Netscape — environment variables
#
# Production values live ONLY in Vercel's env vars. Never commit real
# secrets. For local dev: `vercel env pull .env.local` after linking.

# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic API key. Provided by the site owner at deploy time.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Rate limiting (recommended for launch) ──────────────────────────────────
# Durable, truly-global rate limiting. These two vars are injected
# automatically when Upstash Redis is attached via the Vercel Marketplace.
# If both are absent, the proxy falls back to a weaker in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instant off-switch. Set to "1" in Vercel to disable AI generation
# immediately (no redeploy needed) — e.g. if a traffic spike threatens cost.
AI_KILL_SWITCH=

# ─── Optional: anonymized analytics logging ──────────────────────────────────
# Leave MONGODB_URI blank to disable logging entirely (the helper never loads).
MONGODB_URI=
MONGODB_DB=ainetscape
# Random 32+ character string so hashed IPs are not guessable.
IP_HASH_SALT=change-me-to-a-random-32-char-string
